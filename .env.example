# Copy values into your hosting dashboard. Never commit real secrets.
PORT=3000
BOT_TOKEN=
WEBAPP_URL=https://your-domain.example
TELEGRAM_WEBHOOK_URL=https://your-domain.example/webhook
TELEGRAM_WEBHOOK_SECRET=
# Telegram API changes are disabled unless explicitly enabled.
ENABLE_TELEGRAM_MENU_BUTTON=false
ENABLE_TELEGRAM_WEBHOOK=false
# Maximum age of Telegram Mini App initData in seconds (default 86400)
INIT_DATA_MAX_AGE=86400

# Admin panel: set long random secrets in the hosting dashboard, never commit real values.
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters
# Optional persistent catalog path on a mounted disk (e.g. /var/data/catalog.seed.json).
# CATALOG_FILE=/var/data/catalog.seed.json
