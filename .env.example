# Copy to .env in your hosting dashboard. Never commit real secrets.
PORT=3000
BOT_TOKEN=
WEBAPP_URL=https://your-domain.example
TELEGRAM_WEBHOOK_URL=https://your-domain.example/webhook
TELEGRAM_WEBHOOK_SECRET=
# Optional: maximum age of Telegram Mini App initData in seconds (default 86400)
INIT_DATA_MAX_AGE=86400
